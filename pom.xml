<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>sib.swiss.swissprot</groupId>
	<artifactId>sparql-readonly</artifactId>
	<version>1.0-SNAPSHOT</version>
	<packaging>jar</packaging>

	<name>sparql-readonly</name>
	<url>http://github.com/jerven/sparql-readonly</url>
	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
		<maven.compiler.release>21</maven.compiler.release>
		<rdf4j.version>6.1.0</rdf4j.version>
		<hardwood.version>1.1.0.Beta1</hardwood.version>
		<native-build-tools.version>1.1.14</native-build-tools.version>
		<loader.mainClass>sib.swiss.swissprot.sparql.ro.Loader</loader.mainClass>
		<loader.imageName>sparql-ro-loader</loader.imageName>
		<!-- native-image of a current GraalVM, e.g. Community/Oracle GraalVM 25.4 -->
		<graalvm.home>${env.GRAALVM_HOME}</graalvm.home>
	</properties>
	<dependencies>
		<dependency>
			<groupId>org.eclipse.rdf4j</groupId>
			<artifactId>rdf4j-runtime</artifactId>
			<type>pom</type>
			<version>${rdf4j.version}</version>
		</dependency>
		<dependency>
			<groupId>junit</groupId>
			<artifactId>junit</artifactId>
			<scope>test</scope>
			<version>4.13.2</version>
		</dependency>
		<!-- https://mvnrepository.com/artifact/org.roaringbitmap/RoaringBitmap -->
		<dependency>
			<groupId>org.roaringbitmap</groupId>
			<artifactId>RoaringBitmap</artifactId>
			<version>1.6.23</version>
		</dependency>
		<dependency>
			<groupId>dev.hardwood</groupId>
			<artifactId>hardwood-core</artifactId>
			<version>${hardwood.version}</version>
		</dependency>
		<!-- hardwood declares its codecs optional; ZSTD is its default write codec -->
		<dependency>
			<groupId>com.github.luben</groupId>
			<artifactId>zstd-jni</artifactId>
			<version>1.5.7-9</version>
		</dependency>
	</dependencies>
	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.16.0</version>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<version>3.6.0</version>
				<configuration>
					<!-- the test data uses XML entities beyond the JDK 24+ JAXP defaults -->
					<argLine>-Djdk.xml.maxGeneralEntitySizeLimit=0 -Djdk.xml.totalEntitySizeLimit=0 -Djdk.xml.entityExpansionLimit=0</argLine>
				</configuration>
			</plugin>
		</plugins>
	</build>
	<profiles>
		<!-- mvn -Pnative package : builds target/sparql-ro-loader with GraalVM native-image -->
		<profile>
			<id>native</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.graalvm.buildtools</groupId>
						<artifactId>native-maven-plugin</artifactId>
						<version>${native-build-tools.version}</version>
						<extensions>true</extensions>
						<executions>
							<execution>
								<id>build-loader</id>
								<goals>
									<goal>compile-no-fork</goal>
								</goals>
								<phase>package</phase>
							</execution>
						</executions>
						<configuration>
							<mainClass>${loader.mainClass}</mainClass>
							<imageName>${loader.imageName}</imageName>
							<metadataRepository>
								<enabled>true</enabled>
							</metadataRepository>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>
		<!--
		  mvn -Pwasm package : builds target/sparql-ro-loader.js and .js.wasm
		  with the GraalVM Web Image backend. Needs Oracle GraalVM 25.1 or
		  later in GRAALVM_HOME and Binaryen 119 or later on the PATH.
		  Run with: node target/sparql-ro-loader.js <store-directory> <rdf-file>...
		-->
		<profile>
			<id>wasm</id>
			<dependencies>
				<!-- JNI can not be used from WebAssembly, without zstd hardwood writes uncompressed -->
				<dependency>
					<groupId>com.github.luben</groupId>
					<artifactId>zstd-jni</artifactId>
					<version>1.5.7-9</version>
					<scope>provided</scope>
				</dependency>
			</dependencies>
			<build>
				<plugins>
					<plugin>
						<groupId>org.codehaus.mojo</groupId>
						<artifactId>exec-maven-plugin</artifactId>
						<version>3.6.4</version>
						<executions>
							<execution>
								<id>build-loader-wasm</id>
								<goals>
									<goal>exec</goal>
								</goals>
								<phase>package</phase>
								<configuration>
									<executable>${graalvm.home}/bin/native-image</executable>
									<workingDirectory>${project.build.directory}</workingDirectory>
									<arguments>
										<!-- must be the first argument -->
										<argument>--tool:svm-wasm</argument>
										<argument>-cp</argument>
										<classpath />
										<argument>-o</argument>
										<argument>${loader.imageName}</argument>
										<argument>${loader.mainClass}</argument>
									</arguments>
								</configuration>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>
	<reporting>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-checkstyle-plugin</artifactId>
				<version>3.6.0</version>
				<configuration>
					<configLocation>config/sun_checks.xml</configLocation>
				</configuration>
			</plugin>

		</plugins>

	</reporting>


</project>
